# ── docker-compose.deploy.yaml variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before:
#   docker compose -f docker-compose.deploy.yaml up -d --build

# PostgreSQL password for the crm_app user
DB_PASSWORD=

# Full URL of the client, used for CORS
CORS_ORIGIN=https://crm.royalautoclub.org

# API base URL the Vite client calls
VITE_API_URL=https://api.royalautoclub.org

# AES-256-GCM encryption key — 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Initial admin ─────────────────────────────────────────────────────────────
# Created + auto-approved on first boot (seedAdmin). ADMIN_EMAIL is also the
# admin allowlist (ADMIN_EMAILS inside the server); such emails bypass approval.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Session secret — 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public URL Better Auth is served from (the API domain)
BETTER_AUTH_URL=https://api.royalautoclub.org
# Comma-separated origins allowed to authenticate (the client domain)
BETTER_AUTH_TRUSTED_ORIGINS=https://crm.royalautoclub.org

# ── MinIO / S3 object storage ─────────────────────────────────────────────────
# S3_ENDPOINT + S3_REGION are set inside docker-compose.deploy.yaml.
S3_BUCKET=crm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket is served under (no trailing slash)
S3_PUBLIC_URL=https://api.royalautoclub.org/media/crm-media

# ── Public marketing API ──────────────────────────────────────────────────────
# Comma-separated static API keys for the read-only /public/* endpoints
PUBLIC_API_KEYS=

# ── Telegram channel auto-poster ──────────────────────────────────────────────
# When a car is created/updated/marked sold (and listingStatus != archived), the
# server posts/edits a media-group post in this channel. Both must be set or
# the feature is silently disabled.
TELEGRAM_BOT_TOKEN=
# Channel id — public username (e.g. @royalautoclub) or numeric (-100…). The
# bot must be an admin of the channel with permission to post.
TELEGRAM_CHANNEL_ID=

# Public site URL used in the post footer link. Defaults to
# https://royalautoclub.org if unset.
SITE_PUBLIC_URL=https://royalautoclub.org

# ── AUTO.RIA advertisement auto-poster ────────────────────────────────────────
# Manual publish per car, then edits/deletes sync automatically. Both must be set
# or the feature is silently disabled. Get credentials at https://developers.ria.com
# (write access to /auto/used/autos must be activated under "Мої дозволи").
AUTORIA_USER_ID=
AUTORIA_API_KEY=
# Photo upload only: PSP_ID login cookie from auto.ria.com (30-day lifetime).
# Ads publish without it, but photos are skipped. Refresh from browser monthly.
AUTORIA_PSP_ID=
# Optional: fixed region/city ids for all ads (the dealership location). If unset,
# the poster resolves them from each car's `location` text against AUTO.RIA cities.
AUTORIA_DEFAULT_REGION_ID=
AUTORIA_DEFAULT_CITY_ID=
# AI option suggestion (Anthropic) — reuse the site's ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPTIONS=claude-sonnet-5
