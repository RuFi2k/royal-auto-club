# Path to pg_dump binary — Windows only; leave unset in Docker (pg_dump is on PATH)
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe

# PostgreSQL connection string
# Append ?connection_limit=20&pool_timeout=15 for production
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/car_dealer_crm"

PORT=3000

# Restrict to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# AES-256-GCM key for encrypting sensitive DB fields (64-char hex = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Session secret — 64-char hex
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public URL Better Auth is served from
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to authenticate (the client)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# ── Initial admin ─────────────────────────────────────────────────────────────
# Comma-separated emails that always have admin access (auto-approved, bypass gate)
ADMIN_EMAILS=
# Password for the first admin, created on boot if it doesn't exist yet
ADMIN_PASSWORD=

# ── MinIO / S3 object storage ─────────────────────────────────────────────────
# S3-compatible endpoint (MinIO in the deploy stack). forcePathStyle is on.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket is served under (no trailing slash)
S3_PUBLIC_URL=http://localhost:9000/crm-media

# Comma-separated static API keys for the read-only /public/* endpoints
# (used by the marketing site for server-to-server fetches)
PUBLIC_API_KEYS=

# ── Telegram channel auto-poster (optional) ───────────────────────────────────
# Both must be set or the feature is silently disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Public site URL used in the post footer link (defaults to https://royalautoclub.org)
SITE_PUBLIC_URL=https://royalautoclub.org

# ── AUTO.RIA advertisement auto-poster (optional) ─────────────────────────────
# Manual publish per car; edits/deletes then sync automatically. Both required or
# the feature is disabled. Credentials + write access: https://developers.ria.com
AUTORIA_USER_ID=
AUTORIA_API_KEY=
# Photo upload ONLY: AUTO.RIA's /photos/upload endpoint authenticates the owner
# via the RIA.com login cookie PSP_ID (30-day lifetime), not user_id/api_key.
# Grab it from browser DevTools while logged into auto.ria.com. Refresh monthly.
# Ads still publish without it — only photos are skipped.
AUTORIA_PSP_ID=
# Override the API base if needed (defaults to https://developers.ria.com)
# AUTORIA_API_URL=https://developers.ria.com
# Optional fixed region/city ids (dealership location). If unset, resolved from
# each car's `location` text against AUTO.RIA's city list.
AUTORIA_DEFAULT_REGION_ID=
AUTORIA_DEFAULT_CITY_ID=

# AI option suggestion (Anthropic). Reuses the site's key; prod can reach
# api.anthropic.com. Without ANTHROPIC_API_KEY the "AI fill" button is hidden.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPTIONS=claude-sonnet-5
