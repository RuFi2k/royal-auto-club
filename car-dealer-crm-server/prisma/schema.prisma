generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EngineType {
  gasoline
  diesel
  electric
  hybrid_gasoline
  hybrid_diesel
  gas
  gasoline_gas
}

enum BodyType {
  sedan
  suv
  crossover
  hatchback
  coupe
  wagon
  minivan
  pickup
  van
  convertible
  liftback
}

enum GearboxType {
  manual
  automatic
  cvt
  robot
  dual_clutch
}

enum Drivetrain {
  fwd
  rwd
  awd
  four_wd
}

enum SellType {
  retail
  wholesale
  auction
  consignment
}

enum CarOrigin {
  EU
  US
  canada
  korea
  japan
  china
  other
}

enum CarLocationStatus {
  owner
  dealership
}

// High-level lifecycle status used by the public site to bucket cars into
// /upcoming, /cars, and the recently-sold strip. `isAvailable` is kept in
// sync (true ⇔ status==available) for backward compatibility with existing
// queries; once all consumers move to listingStatus we can drop isAvailable.
enum ListingStatus {
  draft      // saved in CRM, but not published yet
  upcoming   // ordered or in transit; not yet for sale
  available  // for sale right now
  sold       // sold; soldAt is set
  archived   // hidden from public listings (admin-only)
}

// Pre-arrival logistics state. Values map to typical dealership workflow.
enum TransitStage {
  ordered
  in_transit
  at_port
  customs
  ready
}

model Car {
  id                   Int               @id @default(autoincrement())

  // Basic info
  brand                String
  model                String
  year                 Int
  mileage              Int               // thousands of km (e.g. 138 = 138,000 km)
  color                String
  vinNumber            String            // stored encrypted; uniqueness enforced via vinNumberHash
  vinNumberHash        String?           @unique // HMAC of plaintext VIN
  registrationNumber   String            // stored encrypted
  countryOfRegistration String

  // Engine & drivetrain
  engineType           EngineType
  engineVolume         Decimal           @db.Decimal(4, 1) // liters, e.g. 2.0
  enginePower          Int               // horsepower
  gearboxType          GearboxType
  drivetrain           Drivetrain

  // Body & interior
  bodyType             BodyType
  doorsCount           Int
  seatsCount           Int

  // Status & logistics
  carOrigin            CarOrigin
  carLocation          CarLocationStatus
  location             String            // physical address / city

  // Sales
  sellType             SellType
  isCryptoAvailable    Boolean           @default(false)
  ownerPrice           Decimal           @db.Decimal(12, 2) // price the owner wants
  dealerPrice          Decimal           @db.Decimal(12, 2) // public asking price (site, Telegram, AUTO.RIA)
  isAvailable          Boolean           @default(false)
  soldAt               DateTime?         // set when isAvailable flips true→false; cleared on re-listing

  // Lifecycle (draft / upcoming / available / sold / archived). New rows default
  // to an unpublished draft; the migration leaves existing rows unchanged.
  listingStatus        ListingStatus     @default(draft)
  eta                  DateTime?         // expected arrival; meaningful only when listingStatus=upcoming
  transitStage         TransitStage?     // current logistics step; null for non-upcoming cars
  estimatedPrice       Decimal?          @db.Decimal(12, 2) // tentative price while in transit

  // Public-facing copy
  shortDescription     String?           // one-liner shown on cards / OG description
  description          String?           // long-form HTML (TipTap output, sanitized server-side)

  // Repair history (for transparency on the public listing)
  accidentFree         Boolean           @default(false)
  crashed              Boolean           @default(false)
  airbagReplaced       Boolean           @default(false)
  crashDetails         String?
  crashBodyParts       String[]          @default([])

  // Management
  responsiblePerson    String            // user email or ID

  // Files (Firebase Storage URLs)
  photoUrl             String?           // legacy denormalized cover; prefer photos[] for gallery
  techPassportUrl      String?
  defectsCheckUrl      String?
  photos               CarPhoto[]
  photoArchives        CarPhotoArchive[]
  options              CarOption[]

  priceChangedAt       DateTime?         // set whenever any price field is updated
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Telegram channel auto-poster — first message id of the sendMediaGroup post
  // for this car. Used to edit caption on subsequent updates / status changes.
  // null when never posted (e.g. archived from creation, or before this feature).
  telegramMessageId    Int?

  // AUTO.RIA advertisement id (the `_id` returned by POST /auto/used/autos).
  // Set when an admin publishes the car to AUTO.RIA; used to edit/delete the ad
  // in sync with CRM changes. null when never published.
  autoriaAdId          String?

  @@map("cars")
  @@index([listingStatus])
  @@index([listingStatus, createdAt(sort: Desc)])
  @@index([listingStatus, soldAt(sort: Desc)])
  @@index([brand])
  @@index([isAvailable])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  AVAILABILITY_CHANGE
  PHOTO_ADD
  PHOTO_DELETE
  PHOTO_REORDER
  TELEGRAM_PUBLISH
  TELEGRAM_DELETE
  AUTORIA_PUBLISH
  AUTORIA_DELETE
  USER_APPROVE
  USER_DISABLE
  USER_ENABLE
  USER_DELETE
  USER_ROLE_CHANGE
  LOGIN
  LOGOUT
}

// admin sees the event log and manages users; manager only operates the CRM.
enum UserRole {
  admin
  manager
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  userId        String
  userEmail     String?     // denormalized: rows stay readable after user deletion
  action        AuditAction
  carId         Int?        // kept after deletion so history is readable
  changedFields Json?       // { field: { from, to } } for UPDATE; snapshot for CREATE/DELETE
  timestamp     DateTime    @default(now())

  @@map("audit_logs")
  @@index([carId])
  @@index([userId])
  @@index([timestamp])
}

// ── Better Auth ───────────────────────────────────────────────────────────────
// User/session/account/verification are managed by Better Auth. `approved` and
// `disabled` are CRM-specific fields driving the access-approval workflow.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  approved      Boolean   @default(false)
  disabled      Boolean   @default(false)
  role          UserRole  @default(manager)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model CarPhoto {
  id        Int      @id @default(autoincrement())
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0) // lowest = cover
  createdAt DateTime @default(now())

  @@map("car_photos")
  @@index([carId, sortOrder])
}

// AUTO.RIA equipment options selected for a car (auto-posted to the ad).
// optionId is the AUTO.RIA option id: for binary (checkbox) options it's the
// classic catalog id (>= 217) and valueId is null; for selectable options it's
// the internal field id (128-139) and valueId holds the chosen value. See
// modules/autoria/options-catalog.ts.
model CarOption {
  id       Int  @id @default(autoincrement())
  carId    Int
  car      Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
  optionId Int
  valueId  Int?

  @@unique([carId, optionId])
  @@index([optionId])
  @@index([optionId, valueId])
  @@map("car_options")
}

model CarPhotoArchive {
  id        Int      @id @default(autoincrement())
  carId     Int
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  createdAt DateTime @default(now())

  @@map("car_photo_archives")
}
